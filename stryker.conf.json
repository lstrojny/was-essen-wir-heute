{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "_comment": "See specs/tech/06_testing.md for scope and threshold rationale.",
    "packageManager": "pnpm",
    "testRunner": "vitest",
    "plugins": ["@stryker-mutator/vitest-runner"],
    "vitest": {
        "configFile": "vitest.config.ts"
    },
    "reporters": ["clear-text", "html", "progress"],
    "htmlReporter": {
        "fileName": "reports/mutation/index.html"
    },
    "coverageAnalysis": "off",
    "concurrency": 2,
    "timeoutMS": 60000,
    "mutate": [
        "src/**/*.ts",
        "!src/**/*.test.ts",
        "!src/**/*.d.ts",
        "!src/test/**",
        "!src/app/**",
        "!src/db/index.ts",
        "!src/db/schema.ts",
        "!src/i18n/messages/**",
        "!src/llm/tools.ts",
        "!src/llm/recipe-synthesis.ts"
    ],
    "thresholds": {
        "high": 100,
        "low": 95,
        "break": 95
    },
    "incremental": false,
    "inPlace": true
}
