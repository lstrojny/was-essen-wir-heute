# Copy to .env.local and fill in. Next.js loads .env files automatically.
# .env.local is gitignored; this file is not.

# SQLite database file path. Defaults to ./data/app.db.
DATABASE_PATH=./data/app.db

# Anthropic API key for the LLM import + refine + chat flows.
# Picked up automatically by @ai-sdk/anthropic.
LITELLM_API_KEY=

LITELLM_BASE_URL=

# Optional model override for chat/synthesis. Defaults to claude-sonnet-4-6.
# LLM_MODEL_CHAT_SYNTHESIS=claude-sonnet-4-6
LLM_MODEL_CHAT_SYNTHESIS=claude-sonnet-4-6

# Spoonacular API key for recipe import.
SPOONACULAR_API_KEY=
